# URL de la API de Supabase (local: http://127.0.0.1:55321)
VITE_SUPABASE_URL=http://127.0.0.1:55321
# Clave publicable (sb_publishable_...) o anon key. Es pública: la seguridad la da RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clave PÚBLICA de Cloudflare Turnstile (CAPTCHA). La de abajo es la de PRUEBA de Cloudflare
# (siempre aprueba): en producción usa la de tu cuenta (dash.cloudflare.com > Turnstile).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Monitoreo de errores (opcional). Vacío = desactivado. Crear el proyecto en sentry.io
# (región UE recomendada) y copiar el DSN. Es público: solo permite ENVIAR reportes.
VITE_SENTRY_DSN=

# --- Solo para scripts locales (npm run db:backup). NUNCA con prefijo VITE_. ---
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[contraseña]@[host]:5432/postgres
# BACKUP_PASSPHRASE=una-frase-larga-y-secreta
# BACKUP_KEEP_DAYS=30

# --- Solo para scripts/servidor, NUNCA con prefijo VITE_ ---
# Conexión directa a Postgres a través del pooler (Supavisor, modo transacción, puerto 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
